<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1FAEE"> <!-- Calm Mint -->

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SOS Location Tracker"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#1D3557"/>

    <!-- Latitude -->
    <TextView
        android:id="@+id/tvLat"
        android:text="Latitude: --"
        android:textSize="18sp"
        android:textColor="#1D3557"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Longitude -->
    <TextView
        android:id="@+id/tvLon"
        android:text="Longitude: --"
        android:textSize="18sp"
        android:textColor="#1D3557"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Address -->
    <TextView
        android:id="@+id/tvAddr"
        android:text="Address: --"
        android:textSize="18sp"
        android:textColor="#1D3557"
        android:layout_marginTop="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Get Location Button -->
    <com.google.android.material.button.MaterialButton

        android:id="@+id/btnGet"
        android:layout_width="match_parent"
        android:background="@drawable/rounded_button"
        android:layout_height="63dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#1D3557"
        android:text="Get Location"
        android:textAlignment="center"
        android:textSize="20dp"
        android:textColor="#FFFFFF" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoiceSOS"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#E63946"
        android:background="@drawable/rounded_button"
        android:text="Voice SOS"
        android:textAlignment="center"
        android:textSize="20dp"
        android:textColor="#FFFFFF" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#1D3557"/>

</LinearLayout>
